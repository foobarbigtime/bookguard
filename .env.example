TZ=America/Toronto

# Safe default: publish only on the Docker host. For direct LAN access, use the
# Unraid server's LAN address. Avoid 0.0.0.0 unless every host interface is intended.
BOOKGUARD_BIND_ADDRESS=127.0.0.1

# Required. The browser will prompt for these credentials.
BOOKGUARD_AUTH_USERNAME=bookguard
BOOKGUARD_AUTH_PASSWORD=

# Persistent BookGuard state. Keep this separate from the Git checkout so a
# compromised runtime cannot modify future build inputs through /config.
BOOKGUARD_CONFIG_HOST_PATH=/mnt/cache/appdata/bookguard-config
# Unraid default runtime identity (nobody:users). All writable BookGuard host
# paths and a mode-0600 Bindery DB should be owned/readable by this identity.
BOOKGUARD_UID=99
BOOKGUARD_GID=100

# Bindery connection
BINDERY_URL=http://host.docker.internal:8787
BINDERY_API_KEY=
BINDERY_DB=/bindery/bindery.db

# Container paths and Bindery path prefixes
AUDIOBOOK_ROOT=/audiobooks
AUDIOBOOK_BINDERY_PREFIX=/data/media/audiobooks
EBOOK_ROOT=/books
EBOOK_BINDERY_PREFIX=/data/media/books
QUARANTINE_ROOT=/quarantine

# Safe reacquisition staging. Enabling this allows only explicitly confirmed,
# one-at-a-time acquisitions. Bindery must use external import, auto-grab must
# be disabled, and its drop folder must map to BookGuard's /staging mount.
# There is no unattended scheduler or automatic admission.
BOOKGUARD_STAGING_ROOT=/staging
BOOKGUARD_BINDERY_DROP_FOLDER=

# v0.6 automation policy. manual is the fail-closed default. observe records
# what BookGuard would do using durable local evidence, but does not mutate
# Bindery, queue state, staging, quarantine, or library media.
BOOKGUARD_AUTOMATION_MODE=manual

BOOKGUARD_AUTOMATIC_REACQUISITION=false
# Opt-in worker that resumes an operator-started acquisition. It never selects
# a release or approves admission; verified acquisitions pause for confirmation.
BOOKGUARD_ACQUISITION_COORDINATOR_ENABLED=false
BOOKGUARD_ACQUISITION_COORDINATOR_INTERVAL_SECONDS=10
# Maximum staged ebook size accepted by the read-only verifier (512 MiB).
BOOKGUARD_MAX_STAGED_EBOOK_BYTES=536870912

# Guarded ebook quarantine/remediation is a separate opt-in. The variable and
# compose.actions.yaml are both required; /books always remains read-only.
BOOKGUARD_EBOOK_ACTIONS_ENABLED=false
BOOKGUARD_EBOOK_ACTION_ROOT=/action-books

# Controlled ebook admission is an independent opt-in. Enabling the variable
# alone is insufficient: start Compose with compose.admission.yaml to add the
# narrow writable library alias. Keep this false until admission readiness is
# clean and Bindery is deliberately in external import mode.
BOOKGUARD_ADMISSION_ENABLED=false
BOOKGUARD_ADMISSION_ROOT=/admission-books
BOOKGUARD_ADMISSION_BINDERY_ROOT=/data/media/books

# Safe default: Bindery actions are disabled.
BOOKGUARD_ALLOW_ACTIONS=false

# Scan behavior
BOOKGUARD_SAMPLE_FILES=3
BOOKGUARD_SCAN_ON_START=false
BOOKGUARD_SCAN_AUDIOBOOKS=true
BOOKGUARD_SCAN_EBOOKS=true
# Check each new Bindery import soon after it appears (minutes between looks).
BOOKGUARD_WATCH_IMPORTS=true
BOOKGUARD_WATCH_IMPORTS_MINUTES=5
# Optional scheduled full scan: off, daily or weekly; time is container local time; day 0=Monday..6=Sunday.
BOOKGUARD_SCAN_SCHEDULE=off
BOOKGUARD_SCAN_SCHEDULE_TIME=03:00
BOOKGUARD_SCAN_SCHEDULE_DAY=6
BOOKGUARD_PROGRESS_EVERY=10

# Matching behavior
BOOKGUARD_TITLE_MIN_SHARED_WORDS=2
BOOKGUARD_AUTHOR_SURNAME_MATCH=true
BOOKGUARD_REJECT_MUSIC_MISMATCH=true
BOOKGUARD_REJECT_STRONG_MISMATCH=true
BOOKGUARD_STRONG_MISMATCH_MIN_SAMPLES=1
BOOKGUARD_STRONG_MISMATCH_CONSENSUS_PERCENT=67

# Optional author aliases/pen names. The Settings page is easier for multiline editing.
# Use literal \n between groups when setting this in .env.
# BOOKGUARD_AUTHOR_ALIASES=J.K. Rowling = Robert Galbraith | Joanne Rowling\nStephen King = Richard Bachman

# Metadata repair. preview never writes files; safe permits only conservative verified repairs.
BOOKGUARD_METADATA_REPAIR_MODE=preview
BOOKGUARD_REPAIR_AUDIOBOOKS=true
BOOKGUARD_REPAIR_EBOOKS=true
BOOKGUARD_REPAIR_NORMALIZE_PASS=true
BOOKGUARD_REPAIR_AUDIO_ALBUM=true
BOOKGUARD_REPAIR_AUDIO_ALBUM_ARTIST=true
BOOKGUARD_REPAIR_AUDIO_GENRE=false
BOOKGUARD_REPAIR_AUDIO_GENRE_VALUE=Audiobook

# Read-only ebook verification and deterministic integrity checks.
BOOKGUARD_VERIFICATION_ENABLED=true
BOOKGUARD_VERIFICATION_FILE_SIGNATURES=true
BOOKGUARD_VERIFICATION_ARCHIVE_SAFETY=true
BOOKGUARD_VERIFICATION_EPUB_STRUCTURE=true
BOOKGUARD_VERIFICATION_PDF_INTEGRITY=true

# Optional malware scanning. Disabled by default. The clamd endpoint is
# deployment-only and cannot be changed from the BookGuard web UI. If scanning
# is enabled while clamd is unavailable, verification fails closed.
BOOKGUARD_VERIFICATION_MALWARE_SCAN=false
BOOKGUARD_CLAMD_HOST=
BOOKGUARD_CLAMD_PORT=3310
BOOKGUARD_MALWARE_SCAN_TIMEOUT_SECONDS=60
BOOKGUARD_MALWARE_MAX_BYTES=536870912
# Maximum ebook size copied into BookGuard's private verification snapshot.
BOOKGUARD_VERIFICATION_SNAPSHOT_MAX_BYTES=536870912
# Official ClamAV container used by compose.clamav.yaml. Override deliberately
# when testing a newer release.
BOOKGUARD_CLAMAV_IMAGE=clamav/clamav:1.5.4

# Dashboard behavior
BOOKGUARD_DASHBOARD_POLL_MS=1500
BOOKGUARD_LIVE_RESULTS_LIMIT=20
BOOKGUARD_RESULT_LIMIT=1000

# Most settings can also be changed from BookGuard's Settings page.
# Settings saved in the UI override these environment defaults.
